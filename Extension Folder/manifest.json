{
  "manifest_version": 3,
  "name": "Phishing Shield",
  "version": "1.0",
  "description": "Checks URLs for phishing using your ML backend.",
  "permissions": [
    "tabs",
    "notifications",
    "webNavigation",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [ 
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Phishing Shield Active"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  } 
}